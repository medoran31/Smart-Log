    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Smartlog.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite en mono-poste aujourd'hui ; migration vers Npgsql/SqlServer
         demain sans changer la couche Services (voir §4 de l'étude). -->
