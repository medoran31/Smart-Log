<Application x:Class="Smartlog.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Smartlog.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BrushFond" Color="#F4F6F8" />
            <SolidColorBrush x:Key="BrushMenu" Color="#1B2733" />
            <SolidColorBrush x:Key="BrushAccent" Color="#2E7D6B" />
            <SolidColorBrush x:Key="BrushTexteClair" Color="#FFFFFF" />
            <BooleanToVisibilityConverter x:Key="BoolVersVisibilite" />
            <conv:InverseBooleanToVisibilityConverter x:Key="BoolVersVisibiliteInverse" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
