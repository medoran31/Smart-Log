<UserControl x:Class="Smartlog.App.Views.VueAvenants"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="{Binding IntituleProjet}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ReferenceMarche, StringFormat=Marché : {0}}" Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="#2E7D6B"
                   Margin="0,0,0,10" TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Liste des avenants -->
            <Border Grid.Column="0" BorderBrush="#D8DEE4" BorderThickness="1"
                    CornerRadius="4" Padding="10" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Avenants du marché" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Avenants}"
                             SelectedItem="{Binding AvenantSelectionne, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,5">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Numero, StringFormat=Avenant n°{0}}" />
                                    <TextBlock FontSize="11" Foreground="Gray">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} — {1}">
                                                <Binding Path="TypeLibelle" />
                                                <Binding Path="StatutLibelle" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontSize="11">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:N2} DA — {1} j">
                                                <Binding Path="MontantDelta" />
                                                <Binding Path="DelaiDeltaJours" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Formulaire et simulation -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border BorderBrush="#D8DEE4" BorderThickness="1" CornerRadius="4" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Numéro :" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Numero}" Margin="0,0,0,8"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Type :" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding OptionsType}"
                                      DisplayMemberPath="Libelle" SelectedItem="{Binding TypeSelectionne, Mode=TwoWay}"
                                      Height="28" Margin="0,0,0,8" IsEnabled="{Binding EstFormulaireEditable}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Montant :" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBox Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,0,8"
                                     IsEnabled="{Binding EstFormulaireEditable}"
                                     Text="{Binding MontantDeltaTexte, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Délai (jours) :" VerticalAlignment="Center" Margin="16,0,8,8" />
                            <TextBox Grid.Row="1" Grid.Column="3" Height="28" Margin="0,0,0,8"
                                     IsEnabled="{Binding EstFormulaireEditable}"
                                     Text="{Binding DelaiDeltaTexte, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="Nouvel avenant" Width="120" Height="32" Margin="0,0,8,0"
                                        Command="{Binding NouvelAvenantCommand}" />
                                <Button Content="Enregistrer le brouillon" Width="170" Height="32" Margin="0,0,8,0"
                                        Command="{Binding EnregistrerBrouillonCommand}" />
                                <Button Content="Valider l'avenant" Width="140" Height="32" Margin="0,0,8,0"
                                        Command="{Binding ValiderCommand}" />
                                <Button Content="Annuler l'avenant" Width="140" Height="32"
                                        Command="{Binding AnnulerAvenantCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                            CornerRadius="4" Padding="12" Margin="0,12,0,0" Background="#F2F8F6">
                        <StackPanel>
                            <TextBlock Text="Simulation (aucune modification du projet)" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccent}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Montant actuel :" />
                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="110,0,0,0"
                                           Text="{Binding MontantActuel, StringFormat={}{0:N2} DA}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Montant après avenant :" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="160,0,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushAccent}"
                                           Text="{Binding NouveauMontant, StringFormat={}{0:N2} DA}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Délai actuel :" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="110,8,0,0"
                                           Text="{Binding DelaiActuelJours, StringFormat={}{0} jours}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Délai après avenant :" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="160,8,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushAccent}"
                                           Text="{Binding NouveauDelaiJours, StringFormat={}{0} jours}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Fin prévisionnelle actuelle :" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="180,8,0,0"
                                           Text="{Binding DateFinActuelle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Nouvelle fin prévisionnelle :" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="190,8,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushAccent}"
                                           Text="{Binding NouvelleDateFin}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
