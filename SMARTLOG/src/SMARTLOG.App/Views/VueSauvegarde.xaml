<UserControl x:Class="Smartlog.App.Views.VueSauvegarde"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="Paramètres — sauvegarde et restauration"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="La base SQLite et les documents de la GED peuvent être copiés à tout moment. La clé Claude n'est jamais incluse dans une sauvegarde."
                       Foreground="#667" TextWrapping="Wrap" Margin="0,0,0,14" />

            <GroupBox Header="Emplacements" Padding="10">
                <StackPanel>
                    <TextBlock Text="Base active :" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CheminBase}" Foreground="#445" TextWrapping="Wrap" />
                    <TextBlock Text="Sauvegardes :" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding DossierSauvegardes}" Foreground="#445" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Créer une sauvegarde" Padding="10" Margin="0,12,0,0">
                <DockPanel>
                    <Button Content="Créer une sauvegarde" Width="170" Height="32"
                            DockPanel.Dock="Right" Margin="10,0,0,0"
                            Command="{Binding CreerCommand}" />
                    <TextBox Height="32" VerticalContentAlignment="Center"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Description facultative de la sauvegarde" />
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Sauvegardes disponibles" Padding="10" Margin="0,12,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Width="170" Margin="10,0,0,0">
                        <Button Content="Restaurer" Height="32" Command="{Binding RestaurerCommand}" />
                        <Button Content="Supprimer" Height="30" Margin="0,8,0,0"
                                Command="{Binding SupprimerCommand}" />
                        <Button Content="Actualiser" Height="30" Margin="0,8,0,0"
                                Command="{Binding ActualiserCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Sauvegardes}" Height="210"
                             SelectedItem="{Binding SauvegardeSelectionnee, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E4E8EC" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DateCreation, StringFormat=dd/MM/yyyy HH:mm}"
                                                       DockPanel.Dock="Right" Foreground="#667" FontSize="11" />
                                            <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#445" />
                                        <TextBlock FontSize="10" Foreground="#667">
                                            <Run Text="{Binding TailleOctets, StringFormat=N0}" /> octets — documents GED inclus :
                                            <Run Text="{Binding ContientDocuments}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <TextBlock Text="La restauration est vérifiée puis programmée : fermez SMARTLOG et relancez-le pour l'appliquer. L'ancienne base est conservée sous le nom smartlog.db.avant-restauration-…"
                       Foreground="#667" TextWrapping="Wrap" Margin="0,10,0,6" />
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushAccent}"
                       TextWrapping="Wrap" FontWeight="SemiBold" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
