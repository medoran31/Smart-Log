<UserControl x:Class="Smartlog.App.Views.VueTableauDeBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E8EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,16" />
            <Setter Property="Width" Value="196" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08" Color="#1B2733" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4E8EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="PanelHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFB" />
            <Setter Property="CornerRadius" Value="10,10,0,0" />
            <Setter Property="BorderBrush" Value="#E4E8EC" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <Style x:Key="ItemCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="#E8EDF1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="ReadOnlyListStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,12,4,12" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LigneValeurStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1B2733" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Bandeau du projet ouvert -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Padding="18,14" Margin="0,0,0,18"
                Visibility="{Binding AProjetOuvert, Converter={StaticResource BoolVersVisibilite}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                        FontSize="16" Width="34" Height="34" ToolTip="Actualiser le tableau de bord"
                        Foreground="{StaticResource BrushAccent}" Background="#F1F6F5"
                        BorderThickness="0" Cursor="Hand"
                        Command="{Binding RafraichirCommand}" />
                <StackPanel>
                    <TextBlock Text="{Binding NomProjet}" FontSize="19" FontWeight="Bold" Foreground="#1B2733" />
                    <TextBlock Text="{Binding SousTitreProjet}" FontSize="12" Foreground="#667788" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- État vide : aucun projet disponible -->
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="48"
                Visibility="{Binding AProjetOuvert, Converter={StaticResource BoolVersVisibiliteInverse}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                           Foreground="#A9B9C6" HorizontalAlignment="Center" />
                <TextBlock Text="Aucun projet ouvert" FontSize="18" FontWeight="SemiBold"
                           Foreground="#1B2733" Margin="0,18,0,8" HorizontalAlignment="Center" />
                <TextBlock Text="Sélectionnez ou créez un projet dans « Mes projets » pour afficher ses indicateurs."
                           FontSize="13" Foreground="#667788" TextAlignment="Center" MaxWidth="460"
                           TextWrapping="Wrap" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Contenu du tableau de bord -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,12"
                      Visibility="{Binding AProjetOuvert, Converter={StaticResource BoolVersVisibilite}}">
            <StackPanel>
                <!-- Indicateurs clés -->
                <ItemsControl ItemsSource="{Binding KpiCards}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource KpiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Icone}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="24" Foreground="{Binding Couleur}"
                                               HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding Valeur}" FontSize="22" FontWeight="Bold"
                                               Foreground="#1B2733" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Libelle}" FontSize="12" Foreground="#667788"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"
                                               TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Alertes et échéances -->
                <Grid Margin="0,12,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,9,0">
                        <StackPanel>
                            <Border Style="{StaticResource PanelHeaderStyle}">
                                <DockPanel>
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="#C0392B" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Alertes &amp; réserves" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1B2733" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ListBox ItemsSource="{Binding AlertesRecentes}" Style="{StaticResource ReadOnlyListStyle}"
                                     MaxHeight="300"
                                     Visibility="{Binding ADesAlertes, Converter={StaticResource BoolVersVisibilite}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ItemCardStyle}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Icone}" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14" Foreground="#C0392B"
                                                               Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="#1B2733" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#667788"
                                                           Margin="22,4,0,0" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" MaxHeight="30" />
                                                <StackPanel Orientation="Horizontal" Margin="22,5,0,0">
                                                    <TextBlock Text="{Binding PrioriteTexte}" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding PrioriteCouleur}" />
                                                    <TextBlock Text="•" FontSize="10" Foreground="#A9B9C6" Margin="6,0" />
                                                    <TextBlock Text="{Binding EcheanceTexte}" FontSize="10"
                                                               Foreground="#667788" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Aucune alerte ni réserve en cours" FontSize="12" Foreground="#8899A6"
                                       HorizontalAlignment="Center" Padding="18"
                                       Visibility="{Binding ADesAlertes, Converter={StaticResource BoolVersVisibiliteInverse}}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="9,0,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource PanelHeaderStyle}">
                                <DockPanel>
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{StaticResource BrushAccent}" Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Prochaines échéances" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1B2733" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ListBox ItemsSource="{Binding ProchainesEcheances}" Style="{StaticResource ReadOnlyListStyle}"
                                     MaxHeight="300"
                                     Visibility="{Binding ADesEcheances, Converter={StaticResource BoolVersVisibilite}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ItemCardStyle}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding TypeIcone}" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14" Foreground="{StaticResource BrushAccent}"
                                                               Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Libelle}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="#1B2733" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#667788"
                                                           Margin="22,4,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="22,5,0,0">
                                                    <TextBlock Text="{Binding ContexteProjet}" FontSize="10"
                                                               Foreground="#2E7D6B" />
                                                    <TextBlock Text="•" FontSize="10" Foreground="#A9B9C6" Margin="6,0" />
                                                    <TextBlock Text="{Binding DateTexte}" FontSize="10"
                                                               Foreground="#C0392B" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Aucune échéance à venir" FontSize="12" Foreground="#8899A6"
                                       HorizontalAlignment="Center" Padding="18"
                                       Visibility="{Binding ADesEcheances, Converter={StaticResource BoolVersVisibiliteInverse}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Finances et planning -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,9,0">
                        <StackPanel>
                            <Border Style="{StaticResource PanelHeaderStyle}">
                                <DockPanel>
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{StaticResource BrushAccent}" Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Avancement financier" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1B2733" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Taux d'avancement" FontSize="13" Foreground="#445566" />
                                    <TextBlock Grid.Column="0" HorizontalAlignment="Right"
                                               Text="{Binding TauxAvancement, StringFormat='{}{0:N1} %'}"
                                               FontSize="13" FontWeight="Bold" Foreground="#2E7D6B" />
                                </Grid>
                                <ProgressBar Value="{Binding TauxAvancement, Mode=OneWay}" Maximum="100" Height="9"
                                             Background="#E9EEF2" Foreground="#2E7D6B" BorderThickness="0"
                                             Margin="0,2,0,18" />
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="Montant initial" FontSize="12" Foreground="#667788" />
                                    <TextBlock Style="{StaticResource LigneValeurStyle}"
                                               Text="{Binding MontantInitial, StringFormat='{}{0:N2} DA'}" />
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="Montant actualisé" FontSize="12" Foreground="#667788" />
                                    <TextBlock Style="{StaticResource LigneValeurStyle}"
                                               Text="{Binding MontantActualise, StringFormat='{}{0:N2} DA'}" />
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="Total payé" FontSize="12" Foreground="#667788" />
                                    <TextBlock Style="{StaticResource LigneValeurStyle}"
                                               Text="{Binding TotalPaye, StringFormat='{}{0:N2} DA'}" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Restant dû" FontSize="12" Foreground="#C0392B" />
                                    <TextBlock Style="{StaticResource LigneValeurStyle}" Foreground="#C0392B"
                                               Text="{Binding RestantDu, StringFormat='{}{0:N2} DA'}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="9,0,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource PanelHeaderStyle}">
                                <DockPanel>
                                    <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{StaticResource BrushAccent}" Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Planning (CPM)" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1B2733" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="Durée du projet" FontSize="12" Foreground="#667788" />
                                    <TextBlock Style="{StaticResource LigneValeurStyle}"
                                               Text="{Binding DureeProjetJours, StringFormat='{}{0} jours'}" />
                                </Grid>
                                <Grid Margin="0,0,0,9">
                                    <TextBlock Text="Tâches critiques" FontSize="12" Foreground="#667788" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#C0392B"
                                               Text="{Binding ResumeTachesCritiques}" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Total tâches" FontSize="12" Foreground="#667788" />
                                    <TextBlock Style="{StaticResource LigneValeurStyle}"
                                               Text="{Binding NombreTaches}" />
                                </Grid>
                                <Separator Background="#E4E8EC" Margin="0,0,0,12" />
                                <TextBlock Text="Chemin critique (prochaines tâches)" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#445566" Margin="0,0,0,8" />
                                <ListBox ItemsSource="{Binding TachesCritiques}" Style="{StaticResource ReadOnlyListStyle}"
                                         Padding="0" MaxHeight="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ItemCardStyle}" Padding="10">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="12" Foreground="#C0392B"
                                                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Libelle}" FontWeight="SemiBold"
                                                                   FontSize="12" Foreground="#1B2733"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Periode}" FontSize="10" Foreground="#667788"
                                                               Margin="20,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
