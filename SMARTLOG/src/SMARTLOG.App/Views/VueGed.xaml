<UserControl x:Class="Smartlog.App.Views.VueGed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Smartlog.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Barre de recherche plein texte et actions -->
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <TextBlock Text="Recherche :" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="320" Height="30" VerticalContentAlignment="Center"
                     Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Mot-clé du nom, du type ou du texte OCR (accent-insensible)"
                     DockPanel.Dock="Left" Margin="0,0,12,0" />
            <Button Content="Importer des pièces" Width="150" Height="30" DockPanel.Dock="Right"
                    Click="Importer_Click" IsEnabled="{Binding ProjetSelectionne}" />
            <Button Content="Actualiser" Width="100" Height="30" DockPanel.Dock="Right"
                    Command="{Binding ActualiserCommand}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{StaticResource BrushAccent}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Arborescence projets / dossiers -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#D8DEE4" BorderThickness="1"
                CornerRadius="4" Padding="8" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Documents par projet" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TreeView Grid.Row="1" ItemsSource="{Binding Arborescence}"
                          SelectedItemChanged="Arborescence_SelectedItemChanged"
                          BorderThickness="0" Background="Transparent">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:NoeudProjet}"
                                                  ItemsSource="{Binding Dossiers}">
                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                <TextBlock Text="{Binding Icone}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Libelle}" ToolTip="{Binding Libelle}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type vm:NoeudDossier}">
                            <StackPanel Orientation="Horizontal" Margin="2,2">
                                <TextBlock Text="{Binding Icone}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Libelle}" />
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Grid>
        </Border>

        <!-- Grille des documents -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#D8DEE4" BorderThickness="1"
                CornerRadius="4" Padding="8" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Pièces indexées" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Documents}"
                          SelectedItem="{Binding DocumentSelectionne, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          AlternatingRowBackground="#F7F9FA" FontSize="12"
                          MouseDoubleClick="Documents_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom du fichier" Binding="{Binding NomFichier}" Width="*" />
                        <DataGridTextColumn Header="Projet" Binding="{Binding ProjetCode}" Width="90" />
                        <DataGridTextColumn Header="Dossier" Binding="{Binding Dossier}" Width="110" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Categorie}" Width="70" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="60" />
                        <DataGridTextColumn Header="Taille" Binding="{Binding TailleLisible}" Width="70" />
                        <DataGridTextColumn Header="Modifié le" Binding="{Binding DateModification, StringFormat=g}" Width="130" />
                        <DataGridTextColumn Header="OCR" Binding="{Binding StatutOcr}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Prévisualisation + génération de modèles -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
                        CornerRadius="4" Padding="12" Background="#F2F8F6">
                    <StackPanel>
                        <TextBlock Text="Prévisualisation" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushAccent}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ApercuNomFichier}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Image Source="{Binding CheminApercuImage}" MaxHeight="180"
                               Stretch="Uniform" Margin="0,4,0,8"
                               Visibility="{Binding EstImageApercu, Converter={StaticResource BoolVersVisibilite}}" />
                        <TextBlock Text="{Binding ApercuMetadonnees}" TextWrapping="Wrap"
                                   FontSize="12" Foreground="#455" Margin="0,0,0,8" />
                        <TextBlock Text="Texte extrait (OCR) :" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ApercuTexte}" TextWrapping="Wrap" FontSize="12"
                                   MaxHeight="170" />
                        <Button Content="Ouvrir le fichier" Height="30" Margin="0,10,0,0"
                                Command="{Binding OuvrirCommand}" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="#D8DEE4" BorderThickness="1" CornerRadius="4"
                        Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Générer un document depuis un modèle" FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Titre :" Margin="0,0,0,3" />
                        <TextBox Text="{Binding TitreDocument, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" Margin="0,0,0,8" />
                        <TextBlock Text="Format :" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding OptionsFormat}" DisplayMemberPath="Libelle"
                                  SelectedValuePath="Valeur" SelectedValue="{Binding FormatDocument, Mode=TwoWay}"
                                  Height="28" Margin="0,0,0,8" />
                        <TextBlock Text="Observations (jeton {{Observations}}) :" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Observations, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" Margin="0,0,0,8" />
                        <TextBlock Text="Modèle (jetons {{Projet.Intitule}}, {{Marche.Reference}}...) :"
                                   Margin="0,0,0,3" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ContenuModele, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="150"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="Insérer" Width="80" DockPanel.Dock="Right"
                                    Command="{Binding InsererJetonCommand}" Margin="8,0,0,0" />
                            <ComboBox ItemsSource="{Binding JetonsDisponibles}" DisplayMemberPath="Cle"
                                      SelectedItem="{Binding JetonSelectionne, Mode=TwoWay}" Height="28" />
                        </DockPanel>
                        <Button Content="Générer et archiver dans la GED" Height="32"
                                Command="{Binding GenererCommand}" />
                    </StackPanel>
                </Border>

                <!-- Modèles Excel prêts à remplir puis à importer dans la GED -->
                <Border BorderBrush="#D8DEE4" BorderThickness="1" CornerRadius="4"
                        Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Modèles Excel à remplir" FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Un classeur par catégorie : projet, contrat/marché, avenant, attachement, situation, finances, réserve, procès-verbal, planning, courrier, alertes, bordereau de prix, document GED et rapport d'activité."
                                   TextWrapping="Wrap" FontSize="12" Foreground="#455" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding MessageModeles}" TextWrapping="Wrap"
                                   FontSize="12" Foreground="{StaticResource BrushAccent}"
                                   Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Créer les modèles" Width="135" Height="30"
                                    Command="{Binding CreerModelesExcelCommand}" />
                            <Button Content="Ouvrir le dossier" Width="135" Height="30"
                                    Command="{Binding OuvrirDossierModelesCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
