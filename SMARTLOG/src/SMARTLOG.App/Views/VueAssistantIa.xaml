<UserControl x:Class="Smartlog.App.Views.VueAssistantIa"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête : projet ouvert et état de la configuration locale -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Projet :" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="280" Height="30" DockPanel.Dock="Left"
                      ItemsSource="{Binding Projets}" DisplayMemberPath="Intitule"
                      SelectedItem="{Binding ProjetSelectionne, Mode=TwoWay}"
                      Margin="0,0,12,0" />
            <TextBlock Text="{Binding ResumeConfiguration}" VerticalAlignment="Center"
                       Foreground="#667" FontSize="11" TextTrimming="CharacterEllipsis"
                       DockPanel.Dock="Right" Margin="12,0,0,0" MaxWidth="380" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center"
                       Foreground="{StaticResource BrushAccent}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Conversation à gauche, provenance à droite -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D8DEE4" BorderThickness="1"
                    CornerRadius="4" Padding="8" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Conversation contextualisée"
                               FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="10"
                               Foreground="#667" Margin="0,0,0,8"
                               Text="Légende : [DOC] extrait de document • [CALCUL] calculé par SMARTLOG • [SUGGESTION] proposition de l'IA" />
                    <ListBox ItemsSource="{Binding Conversation}" BorderThickness="0"
                             Background="Transparent" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E4E8EC" BorderThickness="0,0,0,1"
                                        Padding="0,6" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RoleLibelle}" FontWeight="SemiBold"
                                                   FontSize="11" Foreground="#336699" />
                                        <TextBlock Text="{Binding Contenu}" TextWrapping="Wrap"
                                                   FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="6,0,0,0">
                <StackPanel>
                    <GroupBox Header="Extrait d'un document (GED / OCR)" Padding="8">
                        <ItemsControl ItemsSource="{Binding Extraits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E4E8EC" BorderThickness="0,0,0,1"
                                            Padding="0,4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Source}" FontWeight="SemiBold"
                                                       FontSize="11" Foreground="#336699"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Contenu}" TextWrapping="Wrap"
                                                       FontSize="11" Foreground="#445" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="Calculé par le système (SMARTLOG)" Padding="8" Margin="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding Calculs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E4E8EC" BorderThickness="0,0,0,1"
                                            Padding="0,4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Valeur}" FontWeight="SemiBold"
                                                           FontSize="11" DockPanel.Dock="Right"
                                                           Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Libelle}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Explication}" FontSize="10"
                                                       Foreground="#667" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Saisie de la question -->
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <Button Content="Effacer" Width="90" Height="32" DockPanel.Dock="Right"
                    Command="{Binding EffacerCommand}" Margin="8,0,0,0" />
            <Button Content="Envoyer à Claude" Width="140" Height="32" DockPanel.Dock="Right"
                    Command="{Binding EnvoyerCommand}" />
            <TextBox Height="32" VerticalContentAlignment="Center"
                     Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Posez votre question sur le projet ouvert" />
        </DockPanel>

        <!-- Suggestions : aucune action sans clic explicite -->
        <GroupBox Grid.Row="3" Padding="8"
                  Header="Suggestions de l'IA — aucune action sans validation explicite">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="10"
                           Foreground="#667" Margin="0,8,0,0"
                           Text="« Valider et appliquer » crée l'entité dans SMARTLOG et l'enregistre dans le journal. « Ignorer » ne modifie aucune donnée métier." />
                <StackPanel DockPanel.Dock="Right" Width="160" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <Button Content="Valider et appliquer" Height="32" FontSize="11"
                            Command="{Binding ValiderAppliquerCommand}" />
                    <Button Content="Ignorer" Height="30" FontSize="11" Margin="0,8,0,0"
                            Command="{Binding IgnorerCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Suggestions}"
                         SelectedItem="{Binding SuggestionSelectionnee, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" Height="112"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E4E8EC" BorderThickness="0,0,0,1" Padding="0,4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontSize="10" Margin="8,0,0,0"
                                               Foreground="#667" Text="{Binding TypeAction}" />
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Titre}" FontWeight="SemiBold"
                                                       FontSize="12" DockPanel.Dock="Left" />
                                            <TextBlock Text="Appliquée" FontSize="10" Foreground="#277A3D"
                                                       Margin="8,0,0,0"
                                                       Visibility="{Binding Appliquee, Converter={StaticResource BoolVersVisibilite}}" />
                                            <TextBlock Text="Ignorée" FontSize="10" Foreground="#C0392B"
                                                       Margin="8,0,0,0"
                                                       Visibility="{Binding Ignoree, Converter={StaticResource BoolVersVisibilite}}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   FontSize="11" Foreground="#445" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
