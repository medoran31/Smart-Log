<UserControl x:Class="Smartlog.App.Views.VueProjets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Filtrer :" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="FiltreProjets" Width="320" Height="30" VerticalContentAlignment="Center"
                     Text="{Binding Filtre, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Code, intitulé, localisation ou statut..." Margin="0,0,12,0" />
            <Button Content="+ Nouveau projet" Width="150" Height="30"
                    Background="{StaticResource BrushAccent}" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                    Command="{Binding AfficherFormulaireCommand}" />
        </StackPanel>

        <!-- Formulaire de création d'un projet -->
        <Border Grid.Row="1" Background="#F2F8F6" BorderBrush="{StaticResource BrushAccent}"
                BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12"
                Visibility="{Binding FormulaireVisible, Converter={StaticResource BoolVersVisibilite}}">
            <StackPanel>
                <TextBlock Text="Créer un nouveau projet" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccent}" />
                <TextBlock Text="{Binding MessageFormulaire}" FontSize="12" Foreground="#C0392B"
                           TextWrapping="Wrap" Margin="0,4,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Code *" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding NouveauCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,6" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Intitulé *" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="3" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding NouvelIntitule, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Localisation" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding NouvelleLocalisation, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,6" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Nature des travaux" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="3" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding NouvelleNatureTravaux, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Montant initial *" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding NouveauMontantInitial, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,6" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Délai contractuel (j) *" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="3" Height="28" VerticalContentAlignment="Center"
                             Text="{Binding NouveauDelaiContractuelJours, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Date de notification" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="3" Grid.Column="1" Height="28"
                                SelectedDate="{Binding NouvelleDateNotification, Mode=TwoWay}" Margin="0,0,16,6" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Date de commencement" VerticalAlignment="Center" />
                    <DatePicker Grid.Row="3" Grid.Column="3" Height="28"
                                SelectedDate="{Binding NouvelleDateCommencement, Mode=TwoWay}" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Statut" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="4" Grid.Column="1" Height="28"
                              ItemsSource="{Binding Statuts}" DisplayMemberPath="Libelle"
                              SelectedValuePath="Valeur" SelectedValue="{Binding NouveauStatut, Mode=TwoWay}" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Annuler" Width="100" Height="30" Margin="0,0,8,0"
                            Command="{Binding AnnulerFormulaireCommand}" />
                    <Button Content="Créer le projet" Width="150" Height="30"
                            Background="{StaticResource BrushAccent}" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                            Command="{Binding CreerProjetCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="ListeProjets" Grid.Row="2"
                  ItemsSource="{Binding ProjetsView}"
                  SelectedItem="{Binding ProjetSelectionne, Mode=TwoWay}"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F7F9FA"
                  BorderThickness="0"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140" />
                <DataGridTextColumn Header="Intitulé" Binding="{Binding Intitule}" Width="*" />
                <DataGridTextColumn Header="Localisation" Binding="{Binding Localisation}" Width="180" />
                <DataGridTextColumn Header="Montant initial" Binding="{Binding MontantInitial, StringFormat={}{0:N2} DA}" Width="150" />
                <DataGridTextColumn Header="Montant actualisé" Binding="{Binding MontantActualise, StringFormat={}{0:N2} DA}" Width="160" />
                <DataGridTextColumn Header="Délai contractuel (j)" Binding="{Binding DelaiContractuelJours}" Width="160" />
                <DataGridTextColumn Header="Délai actualisé (j)" Binding="{Binding DelaiActualiseJours}" Width="150" />
                <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
