<UserControl x:Class="Smartlog.App.Views.VueCourriers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Projet :" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="320" Height="30" DockPanel.Dock="Left"
                      ItemsSource="{Binding Projets}" DisplayMemberPath="Intitule"
                      SelectedItem="{Binding ProjetSelectionne, Mode=TwoWay}"
                      Margin="0,0,12,0" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{StaticResource BrushAccent}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#D8DEE4" BorderThickness="1" CornerRadius="4"
                Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Row="0" Grid.Column="0" Height="28" Margin="0,0,8,8"
                          ItemsSource="{Binding Sens}" DisplayMemberPath="Libelle"
                          SelectedItem="{Binding SensSelectionne, Mode=TwoWay}" ToolTip="Sens du courrier" />
                <TextBox Grid.Row="0" Grid.Column="1" Height="28" Margin="0,0,8,8"
                         Text="{Binding Expediteur, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Expéditeur" />
                <TextBox Grid.Row="0" Grid.Column="2" Height="28" Margin="0,0,8,8"
                         Text="{Binding Destinataire, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Destinataire" />
                <TextBox Grid.Row="0" Grid.Column="3" Height="28" Margin="0,0,8,8"
                         Text="{Binding DateCourrierTexte, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Date du courrier (AAAA-MM-JJ)" />
                <TextBox Grid.Row="0" Grid.Column="4" Height="28" Margin="0,0,0,8"
                         Text="{Binding DelaiReponseTexte, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Délai de réponse en jours (facultatif)" />
                <TextBox Grid.Row="0" Grid.Column="5" Height="28" Margin="8,0,0,8"
                         Text="{Binding DateReponseTexte, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Date de réponse (AAAA-MM-JJ)" />

                <DockPanel Grid.Row="1" Grid.ColumnSpan="6">
                    <TextBox Height="28" Margin="0,0,12,0"
                             Text="{Binding Objet, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Objet du courrier" />
                    <Button Content="Nouveau courrier" Width="135" Height="28" DockPanel.Dock="Right"
                            Command="{Binding CreerCommand}" />
                    <Button Content="Enregistrer la réponse" Width="165" Height="28" Margin="8,0,0,0"
                            DockPanel.Dock="Right" Command="{Binding EnregistrerReponseCommand}" />
                    <Button Content="Sans suite" Width="100" Height="28" Margin="8,0,0,0"
                            DockPanel.Dock="Right" Command="{Binding MarquerSansSuiteCommand}" />
                </DockPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Courriers}"
                  SelectedItem="{Binding CourrierSelectionne, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  AlternatingRowBackground="#F7F9FA" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sens" Binding="{Binding SensLibelle}" Width="75" />
                <DataGridTextColumn Header="Date" Binding="{Binding DateCourrier, StringFormat=dd/MM/yyyy}" Width="100" />
                <DataGridTextColumn Header="Expéditeur" Binding="{Binding Expediteur}" Width="180" />
                <DataGridTextColumn Header="Destinataire" Binding="{Binding Destinataire}" Width="180" />
                <DataGridTextColumn Header="Objet" Binding="{Binding Objet}" Width="*" />
                <DataGridTextColumn Header="Échéance" Binding="{Binding DateEcheanceReponse, StringFormat=dd/MM/yyyy}" Width="105" />
                <DataGridTextColumn Header="Statut" Binding="{Binding StatutLibelle}" Width="95" />
                <DataGridTextColumn Header="Réponse" Binding="{Binding DateReponse, StringFormat=dd/MM/yyyy}" Width="105" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EstEnRetard}" Value="True">
                            <Setter Property="Background" Value="#FDEDEC" />
                            <Setter Property="Foreground" Value="#C0392B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="11" Foreground="#667"
                   Text="Les échéances de réponse sont calculées : date du courrier + délai de réponse. Le centre d'alertes signale les courriers en attente hors délai." />
    </Grid>
</UserControl>
