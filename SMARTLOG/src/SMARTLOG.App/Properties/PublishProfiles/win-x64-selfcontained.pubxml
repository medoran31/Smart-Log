<?xml version="1.0" encoding="utf-8"?>
<!--
  Publication Windows autonome : aucun runtime .NET n'est requis sur le poste
  cible. Le dossier de sortie contient SMARTLOG.App.exe et ses dépendances.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\Release\net8.0-windows\win-x64\publish\</PublishDir>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
